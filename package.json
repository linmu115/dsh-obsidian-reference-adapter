{
  "name": "dsh-obsidian-reference-adapter",
  "version": "0.1.0",
  "description": "Obsidian note reference adapter for dsh-annotation-core.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node -e \"fs.rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsdown --config-loader unrun --config tsdown.config.ts",
    "prepack": "pnpm build",
    "pretest": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm pack --dry-run --json"
  },
  "dependencies": { "zod": "4.4.3" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "dsh-annotation-core": "*",
    "dsh-obsidian-bridge-lifecycle": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "dsh-annotation-core": { "optional": true },
    "dsh-obsidian-bridge-lifecycle": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^24.3.0",
    "dsh-annotation-core": "link:../dsh-annotation-core",
    "dsh-obsidian-bridge-lifecycle": "link:../dsh-obsidian-bridge-lifecycle",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "unrun": "^0.3.1",
    "vitest": "^4.1.11"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": ["dsh-annotation-core", "dsh-obsidian-bridge-lifecycle"]
    }
  },
  "dshKnowledge": { "annotationProtocolVersion": 2, "bridgeLifecycleProtocolVersion": 1 },
  "packageManager": "pnpm@11.19.0",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "https://github.com/linmu115/dsh-obsidian-reference-adapter.git"
  }
}
